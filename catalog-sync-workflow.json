      ]
    },
    {
      "parameters": {
        "jsCode": "const products = $input.all().map(i => i.json);\nreturn [{ json: { marketplace_products: products } }];"
      },
      "id": "9863ce2c-0044-4d85-8382-b4f8071f0b93",
      "name": "Wrap Marketplace",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
