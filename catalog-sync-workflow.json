    {
      "parameters": {},
      "id": "1610b678-9c9e-4c5a-81af-2d7bd42571f0",
      "name": "Merge Catalogs",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1088,
