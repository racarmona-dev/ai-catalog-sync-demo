      "id": "c935458a-cdd4-4011-a8c0-0d489778ef0b",
      "name": "Aggregate Catalogs",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1408,
        352
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You receive two product lists from a marketplace and a supplier.\nIdentify products where the name OR price diverges.\nProducts are matched by their position/index (same order in both lists).\n\nRules:\n- If name differs (case-insensitive): it is a divergence\n- If price differs by more than 0.01: it is a divergence\n- If both match: skip the product\n\nMarketplace products:\n{{ JSON.stringify($json.data[0].marketplace_products, null, 2) }}\n\nSupplier products:\n{{ JSON.stringify($json.data[1].supplier_products, null, 2) }}\n\nReturn ONLY a valid JSON object, no extra text, no markdown:\n{\n  \"updates\": [\n    {\n      \"marketplace_id\": <id from marketplace product>,\n      \"name\": <supplier name>,\n      \"price\": <supplier price>\n    }\n  ]\n}\n\nIf no divergences found, return: {\"updates\": []}"
      },
      "id": "97ab12f0-49a7-47de-9b61-5fd279122edb",
      "name": "Catalog Sync AI Agent",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1648,
        352
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {}
      },
      "id": "d8724d0e-75ce-464b-8770-5b7aa83660e9",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1648,
        576
      ],
      "credentials": {
        "openAiApi": {
          "id": "Cxnw1xphZUdf3APM",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.text || '';\n\nlet parsed = null;\ntry {\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  if (match) parsed = JSON.parse(match[0]);\n} catch (e) {\n  parsed = { updates: [] };\n}\n\nif (!parsed || !Array.isArray(parsed.updates)) {\n  parsed = { updates: [] };\n}\n\nif (parsed.updates.length === 0) {\n  return [{ json: { message: 'Catalog is already in sync. No changes needed.' } }];\n}\n\nreturn parsed.updates.map(u => ({ json: u }));"
      },
      "id": "abc64074-5158-4685-8321-2c17a75dab4c",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1904,
        352
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "check-marketplace-id",
              "leftValue": "={{ $json.marketplace_id }}",
              "rightValue": "",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "dca080b8-3c85-49e2-a76c-c9e40622ea47",
      "name": "Has Updates?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2160,
        352
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=http://host.docker.internal:8080/api/products/{{ $json.marketplace_id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"name\": $json.name, \"price\": $json.price } }}",
        "options": {}
      },
      "id": "376babe2-82c6-4443-8639-d1c3cceba282",
      "name": "Update Marketplace Product",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
